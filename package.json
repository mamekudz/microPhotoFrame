{
  "name": "microphotoframe",
  "version": "1.5.2",
  "description": "WiFi-based E-Ink photo frame firmware for reTerminal E1002, GooDisplay NeoFrame, and Waveshare ESP32-S3 1.54inch e-Paper (G)",
  "author": "Meinolf Amekudzi",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "neoframe",
    "gdp073ew1",
    "gdep073e01",
    "goodisplay",
    "waveshare",
    "gdey0154f51",
    "bwry",
    "reterminal",
    "e1002",
    "e1001",
    "spectra6",
    "e-ink",
    "epaper",
    "esp32-s3",
    "photo-frame",
    "microphotoframe"
  ],
  "workspaces": [
    "ink-encoder"
  ],
  "scripts": {
    "build:packages": "gulp BUILD_ALL_SERVER_PACKAGES",
    "build:installer": "gulp BUILD_INSTALLER",
    "fetch:installer-assets": "gulp FETCH_INSTALLER_ASSETS",
    "build:server:pick": "gulp BUILD_SERVER_PACKAGES",
    "encode:ink": "gulp ENCODE_INK",
    "firmware:build": "gulp FIRMWARE_BUILD",
    "firmware:upload": "gulp FIRMWARE_UPLOAD",
    "firmware:monitor": "gulp FIRMWARE_MONITOR",
    "firmware:upload-monitor": "gulp FIRMWARE_UPLOAD_MONITOR",
    "firmware:restore": "gulp FIRMWARE_RESTORE_FACTORY",
    "backup": "gulp BACKUP_TO_NAS",
    "test:nas": "node --test tools/nas-backup.test.mjs",
    "test:platforms": "node --test tools/photoframe-platforms.test.mjs tools/photoframe-build-filter.test.mjs",
    "test:channels": "node --test tools/channels.test.mjs",
    "test:ai-model": "node --test tools/ai-model.test.mjs",
    "test:ink": "npm test -w ink-encoder",
    "test:ink-release": "node --test tools/ink-encoder-release.test.mjs",
    "publish:ink": "gulp PUBLISH_INK_ENCODER",
    "init": "gulp INIT",
    "gulp:tasks": "gulp --tasks",
    "gen:branding": "node tools/gen-embedded-branding.mjs",
    "release:check": "node tools/release.mjs check",
    "test:release": "node --test tools/release.test.mjs",
    "build:manual": "python tools/build-manual.py"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "ink-encoder": "file:ink-encoder",
    "jszip": "^3.10.1",
    "merge2": "^1.4.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "gulp": "^5.0.1",
    "gulp-clean": "^0.4.0",
    "gulp-cli": "^3.1.0",
    "gulp-concat": "^2.6.1",
    "gulp-mu-build-filter": "^2.0.7",
    "gulp-mu-gulp-api": "^0.4.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-zip": "^6.1.0"
  }
}
