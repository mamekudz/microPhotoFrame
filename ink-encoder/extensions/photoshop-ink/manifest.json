{
  "manifestVersion": 5,
  "id": "com.inkencoder.photoshop",
  "name": "INK E-Paper",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "inkEpaperPanel",
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 500, "height": 1200 },
      "preferredDockedSize": { "width": 280, "height": 400 },
      "icons": [],
      "label": { "default": "INK E-Paper" }
    }
  ],
  "icons": [],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
