{
  "gulptasks.pattern": "**/gulpfile.{js,mjs,cjs}",
  "npm.enableScriptExplorer": true,
  "npm.autoDetect": "on",
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}\\node_modules\\.bin;${env:PATH}"
  },
  "terminal.integrated.env.osx": {
    "PATH": "${workspaceFolder}/node_modules/.bin:${env:PATH}"
  },
  "terminal.integrated.env.linux": {
    "PATH": "${workspaceFolder}/node_modules/.bin:${env:PATH}"
  },
  "taskexplorer.enabledTasks": {
    "ant": false,
    "apppublisher": false,
    "bash": true,
    "batch": true,
    "composer": false,
    "eslint": true,
    "gradle": false,
    "grunt": false,
    "gulp": true,
    "jenkins": false,
    "laravel": false,
    "make": false,
    "maven": false,
    "nodejs": false,
    "npm": true,
    "nsis": false,
    "perl": false,
    "pipenv": false,
    "powershell": true,
    "python": true,
    "ruby": false,
    "tsc": true,
    "webpack": false,
    "webpackwrap": false,
    "workspace": true
  },
  "taskexplorer.useGulp": true,
  "platformio-ide.useBuiltinPIOCore": false,
  "platformio-ide.showEditorTitleShortcuts": true,
  "platformio-ide.activateProjectOnTextEditorChange": true,
  "idf.currentSetup": "C:/Espressif/frameworks/esp-idf-v5.3.1/",
  "platformio-ide.toolbar": [
    { "text": "PIO", "tooltip": "PlatformIO: Home", "commands": "platformio-ide.showHome" },
    { "text": "Build", "tooltip": "PlatformIO: Build", "commands": "platformio-ide.build" },
    { "text": "Upload", "tooltip": "PlatformIO: Upload", "commands": "platformio-ide.upload" },
    { "text": "Clean", "tooltip": "PlatformIO: Clean", "commands": "platformio-ide.clean" },
    { "text": "Monitor", "tooltip": "PlatformIO: Serial Monitor", "commands": "platformio-ide.serialMonitor" }
  ]
}
